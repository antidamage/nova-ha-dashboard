{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.local/schemas/phonoscope-module-v1.json",
  "title": "Nova Phonoscope Module",
  "type": "object",
  "required": ["id", "version", "name", "dimension", "bounds", "scene"],
  "additionalProperties": false,
  "properties": {
    "engineVersion": { "const": 1, "default": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "maxLength": 1024 },
    "dimension": { "enum": ["2d", "3d"] },
    "bounds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vector" },
        "max": { "$ref": "#/$defs/vector" }
      }
    },
    "boundary": { "$ref": "#/$defs/boundary" },
    "settings": {
      "type": "array",
      "items": { "$ref": "#/$defs/setting" }
    },
    "templates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/entity" }
    },
    "scene": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    },
    "resources": {
      "type": "object",
      "properties": {
        "maxParticles": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "maxInteractiveFieldEntities": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "maxRenderBatches": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "license": { "type": "string" },
        "tags": { "type": "array", "maxItems": 32, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        { "type": "number" },
        { "type": "boolean" },
        { "type": "string" },
        { "type": "array", "items": { "type": ["number", "string"] }, "minItems": 2, "maxItems": 4 }
      ]
    },
    "vector": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 3
    },
    "setting": {
      "type": "object",
      "required": ["id", "default"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
        "label": { "type": "string" },
        "description": { "type": "string", "maxLength": 512 },
        "control": { "enum": ["slider", "number", "toggle", "select"], "default": "slider" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "default": { "type": "number" },
        "affects": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.\\-\\[\\]]{0,127}$" }
        },
        "curve": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["linear", "power"], "default": "linear" },
            "exponent": { "type": "number", "minimum": 0.1, "maximum": 8 }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "number" }
            }
          }
        }
      }
    },
    "boundary": {
      "oneOf": [
        { "enum": ["despawn", "wrap", "bounce", "slide", "clamp", "respawn"] },
        {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["despawn", "wrap", "bounce", "slide", "clamp", "respawn", "trigger"] },
            "restitution": { "type": "number", "minimum": 0, "maximum": 1.5 },
            "then": { "enum": ["despawn", "wrap", "bounce", "slide", "clamp", "respawn"] },
            "effect": { "type": "string" }
          }
        }
      ]
    },
    "effect": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trigger": { "enum": ["spawn", "death", "collision", "boundary", "beat", "bar", "lyric", "threshold", "timer", "received"] },
        "shape": { "enum": ["point", "line", "plane", "circle", "sphere", "box", "field"] },
        "kind": { "enum": ["force", "impulse", "wave", "channel", "spawn", "material", "custom"] },
        "propagation": { "enum": ["radial", "neighbours", "diffusion", "overlap"] },
        "strength": { "$ref": "#/$defs/value" },
        "speed": { "$ref": "#/$defs/value" },
        "falloff": { "$ref": "#/$defs/value" },
        "anticipation": { "$ref": "#/$defs/value" },
        "attack": { "$ref": "#/$defs/value" },
        "release": { "$ref": "#/$defs/value" },
        "flashPower": { "$ref": "#/$defs/value" },
        "duration": { "$ref": "#/$defs/value" },
        "channel": { "type": "string" }
      }
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "template": { "type": "string" },
        "parameters": { "type": "object" },
        "transform": { "type": "object" },
        "render": { "type": "object" },
        "material": { "type": "object" },
        "physics": { "$ref": "#/$defs/physics" },
        "field": {
          "type": "object",
          "required": ["layout", "template"],
          "properties": {
            "layout": { "enum": ["grid", "radial", "random", "line", "volume", "meshSurface"] },
            "template": { "type": "string" },
            "count": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "resolution": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 3 },
            "topology": { "enum": ["grid", "radius", "nearest", "none"] },
            "channels": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
            "boundary": { "$ref": "#/$defs/boundary" }
          }
        },
        "emitter": { "type": "object" },
        "effectSources": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "effectReceivers": { "type": "array", "items": { "type": "object" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "boundary": { "$ref": "#/$defs/boundary" },
        "lifetime": { "$ref": "#/$defs/value" }
      }
    },
    "physics": {
      "type": "object",
      "properties": {
        "velocity": { "$ref": "#/$defs/value" },
        "mass": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "string", "pattern": "^=" }
          ]
        },
        "drag": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string", "pattern": "^=" }
          ]
        },
        "inertia": {
          "description": "Momentum retained per nominal 60 Hz frame; 0 stops immediately and 1 glides indefinitely.",
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "string", "pattern": "^=" }
          ],
          "default": 0.985
        },
        "gravity": { "$ref": "#/$defs/value" }
      }
    }
  }
}
