[Unit]
Description=Caddy TLS front for Nova dashboard and browser voice (iridium)
After=network-online.target tailscaled.service nova-ha-dashboard.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
# Config path is deliberately NOT /etc/caddy/Caddyfile. Iridium already runs a
# separate user-scoped caddy.service for the OpenClaw gateway that owns that
# file and binds :8443. Writing to it would silently break OpenClaw, so Nova's
# system-scoped Caddy keeps its own config and its own port (:443).
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/nova.Caddyfile --adapter caddyfile
# No ExecReload on purpose. `caddy reload` drives the admin API, and this
# Caddyfile sets `admin off`, so the reload could never work — `systemctl reload
# nova-caddy` just failed with "Job for nova-caddy.service failed" while the
# service was healthy, which is a confusing thing to hand an operator mid-incident.
# Use `systemctl restart nova-caddy` instead; it is sub-second here.
Restart=always
RestartSec=5

# Caddy resolves its data directory (ACME account keys, issued certificates)
# from $HOME. systemd units get an empty environment, so without this Caddy logs
# "$HOME environment variable is empty - please fix" and falls back to ./caddy
# relative to the working directory. StateDirectory= creates and owns
# /var/lib/caddy, giving the tailnet certificate a stable home across restarts.
Environment=HOME=/var/lib/caddy
StateDirectory=caddy

# NOVA_LLM_KEY for the /internal-llm/* route's {$NOVA_LLM_KEY} matcher (see
# nova.Caddyfile). The leading "-" makes this optional: a host that hasn't
# created /etc/nova-caddy.env yet still starts fine, it just serves that one
# route as permanently 403 (an empty env var never matches a real header).
# This file is NOT part of the repo and NOT touched by deploy-nova-dashboard.ps1
# on purpose — it holds a secret and this repo has a public remote.
EnvironmentFile=-/etc/nova-caddy.env

[Install]
WantedBy=multi-user.target
