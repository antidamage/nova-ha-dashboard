[Unit]
Description=Nova Home Assistant Dashboard (iridium bare metal)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f nova-ha-dashboard
# Iridium variant of ops/vm/nova-ha-dashboard.service. No render node, no v4l
# capture device, no /dev bind: the camera does not live here and the dashboard
# consumes it via videoHostUrl. Image is the plain (non-VAAPI) runtime built
# from ops/Dockerfile.
#
# Memory caps are passed to `docker run`, NOT set as systemd MemoryHigh= on this
# unit. `docker run` places the container under docker's own cgroup scope
# (/sys/fs/cgroup/system.slice/docker-<id>.scope), so a unit-level MemoryHigh=
# constrains only the short-lived client process and does nothing to the app.
#
# --memory-reservation is the soft limit: next-server's working set grows to
# ~1.3 GB through GC churn (not a leak), so 1536m lets the kernel start
# reclaiming against it under contention. --memory 3g is the backstop that keeps
# a runaway dashboard from ever reaching nova-voice.service's 8.3 GB peak on a
# 22 GB box.
ExecStart=/usr/bin/docker run --rm --name nova-ha-dashboard --network host \
  --add-host nocturnium.local:192.168.8.17 \
  --memory-reservation=1536m --memory=3g \
  --env-file /opt/nova-ha-dashboard/.env.local \
  -e NODE_ENV=production -e PORT=80 \
  -v /opt/nova-ha-dashboard:/app -w /app \
  nova-ha-dashboard:plain npm start
ExecStop=/usr/bin/docker stop nova-ha-dashboard

[Install]
WantedBy=multi-user.target
