[Unit]
Description=Nova daytime camera event detection and review service
After=network-online.target docker.service nova-ha-dashboard.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f nova-camera-events
ExecStartPre=/usr/bin/install -d -m 0755 /opt/nova-ha-dashboard/data/camera-events
ExecStart=/usr/bin/docker run --rm --name nova-camera-events --network host --gpus all \
  --memory-reservation=2500m --memory=5g --shm-size=1g \
  --env-file /opt/nova-ha-dashboard/.env.local \
  -e NOVA_CAMERA_EVENTS_DATA=/data \
  -e NOVA_CAMERA_EVENTS_SOURCE=http://192.168.8.17:8080/camera/outside/index.m3u8 \
  -e HF_HOME=/data/models/huggingface \
  -e ULTRALYTICS_CONFIG_DIR=/data/models/ultralytics \
  -v /opt/nova-ha-dashboard/data/camera-events:/data \
  nova-camera-events:local
ExecStop=/usr/bin/docker stop nova-camera-events

[Install]
WantedBy=multi-user.target
