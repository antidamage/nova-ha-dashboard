[Unit]
Description=Nocturnium Outside-camera CORS/path proxy
After=network-online.target nova-ha-dashboard.service
Wants=network-online.target nova-ha-dashboard.service

[Service]
Type=simple
User=antidamage
ExecStart=/usr/bin/python3 /opt/nova-ha-dashboard/ops/nocturnium-camera-proxy.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
