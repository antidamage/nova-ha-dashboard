# Which dashboard backend the kiosk on this box points at.
#
# Installed to ~/.config/nova-kiosk/backend.env by ops/kiosk/install-kiosk.sh.
# Read by brave-kiosk-launch.sh (launch URL) and kiosk-cdp-probe.py (which tab
# counts as "the dashboard page"). Changing this line and letting the guard
# relaunch Brave (or running brave-kiosk-launch.sh) is the ENTIRE client-side
# cutover between backends:
#
#   local dashboard (original nova hosting role):  http://127.0.0.1/
#   VM appliance on the VM host:                   http://<vm-host>/  (see PRIVATEREF.md#1.2)
NOVA_BACKEND_URL=http://127.0.0.1/
