      "colors": [
        { "theme": "line1", "alpha": 0.55 },
        { "theme": "line2", "alpha": 0.55 },
        { "theme": "line3", "alpha": 0.55 }
      ],
      "idleSweepMin": 0.08,
      "idleSweepMax": 0.25,
