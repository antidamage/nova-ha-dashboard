.next-start-*.err.log

# local tooling artifacts
.codex/
.cache/
.tmp/
.playwright-cli/
output/
data/*.json
data/*.jsonl
# Runtime state written by the power module: accumulated kWh, and billing
# history imported from a retailer account. `data/*.json` only covers the top
# level, so these were being tracked -- account-usage.json carried 24 months of
# one household's real electricity bills into a public repo. The real values
# live in the household package's power.accountHistory; these files are per
# install and regenerate themselves.
data/power/
# Atomic writes land as `<name>.<pid>.tmp` before the rename. A crash between
# the two leaves one behind, and a couple got committed -- carrying this
# household's aircon settings, theme and reminder list with them.
data/**/*.tmp
data/*.tmp
data/camera/
data/gymmaster/
# The preferences undo history: per-install runtime state, written on every
# save. Nothing in it is source, and it is unique to the machine it grew on.
data/history/
data/managed-computer-keys/
data/managed-desktop-known-hosts/
data/nova-voice-tls/
data/terrain-fetches/
data/*-sleep-token.txt
data/wallpapers/
# Secret-knock rhythm templates. Encrypted at rest, but an unlock credential
# is not something to publish even in ciphertext (data/*.json misses .enc).
data/doorbell-secrets.json.enc
__pycache__/
*.pyc

# OS/editor noise
.DS_Store
Thumbs.db

# Cygwin/Git-Bash crash dumps (created anywhere a bash tool crashes).
bash.exe.stackdump
**/bash.exe.stackdump

# TypeScript incremental build cache, regenerated by every build.
tsconfig.tsbuildinfo
*.tsbuildinfo
