HA_URL=http://127.0.0.1:8123
HA_TOKEN=
TZ=Pacific/Auckland
NOVA_DASHBOARD_MCP_TOKEN=
NOVA_DASHBOARD_CONFIG=
# Deployed voice-server URL: see PRIVATEREF.md#1.3.
NOVA_VOICE_IRIDIUM_URL=https://voice-server.local:8766
# Browser satellite bridge. The deployed Caddy route exposes this at
# wss://nova.tuatara-dory.ts.net/voice-satellite; these files secure only the
# loopback Caddy-to-bridge hop and can use the existing household certificate.
NOVA_DASHBOARD_TLS_CERT=/app/data/nova-dashboard-tls/server.crt
NOVA_DASHBOARD_TLS_KEY=/app/data/nova-dashboard-tls/server.key
NOVA_VOICE_BRIDGE_PORT=8767
# Optional overrides. Leave unset in production to use same-origin WSS.
# NEXT_PUBLIC_NOVA_VOICE_BRIDGE_URL=wss://example.invalid/voice-satellite
# NEXT_PUBLIC_NOVA_VOICE_BRIDGE_PORT=8767
NEXT_PUBLIC_MAP_CENTER=-36.8509,174.7645
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
ICLOUD_CALENDARS=
ICLOUD_REMINDERS=
ICLOUD_SYNC_DAYS=7
POWERSHOP_EMAIL=
POWERSHOP_PASSWORD=
POWERSHOP_DATA_DIR=data/power/powershop
NOVA_FFMPEG_PATH=
NOVA_CAMERA_FONT=
NOVA_CAMERA_OUTSIDE_DEVICE=
NOVA_CAMERA_OUTSIDE_INPUT_FORMAT=v4l2
NOVA_CAMERA_OUTSIDE_PIXEL_FORMAT=
NOVA_CAMERA_OUTSIDE_STANDARD=PAL
NOVA_CAMERA_OUTSIDE_FRAME_SIZE=720x576
NOVA_CAMERA_OUTSIDE_FRAME_RATE=25
NOVA_CAMERA_OUTSIDE_BRIGHTNESS=0
NOVA_CAMERA_OUTSIDE_CONTRAST=1
NOVA_CAMERA_OUTSIDE_SHARPNESS=0
